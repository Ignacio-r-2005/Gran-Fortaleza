<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gimnasio Gran Fortaleza</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: Arial, sans-serif; background: #f0f2f5; color: #333; }

    header {
      background: #1a1a2e; color: white;
      padding: 1rem 2rem;
      display: flex; align-items: center; gap: 1rem;
    }
    header h1 { font-size: 1.4rem; }

    main { max-width: 960px; margin: 2rem auto; padding: 0 1rem; }

    h2 { font-size: 1.1rem; margin-bottom: 1rem; color: #1a1a2e; border-bottom: 2px solid #1a1a2e; padding-bottom: 0.3rem; }

    section { background: white; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }

    /* Tabla de turnos */
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th { background: #1a1a2e; color: white; padding: 0.6rem 0.8rem; text-align: left; }
    td { padding: 0.6rem 0.8rem; border-bottom: 1px solid #eee; }
    tr:last-child td { border-bottom: none; }
    .badge {
      display: inline-block; padding: 0.2rem 0.6rem;
      border-radius: 12px; font-size: 0.78rem; font-weight: bold;
    }
    .badge-ok  { background: #d4edda; color: #155724; }
    .badge-no  { background: #f8d7da; color: #721c24; }

    /* Formularios */
    form { display: grid; gap: 0.8rem; }
    label { font-size: 0.88rem; font-weight: bold; }
    input, select {
      width: 100%; padding: 0.5rem 0.7rem;
      border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem;
    }
    button {
      padding: 0.6rem 1.2rem; border: none; border-radius: 4px;
      cursor: pointer; font-size: 0.9rem; font-weight: bold;
    }
    .btn-primary   { background: #1a1a2e; color: white; }
    .btn-danger    { background: #c0392b; color: white; }
    button:hover   { opacity: 0.85; }

    /* Mensajes */
    #mensaje {
      padding: 0.8rem 1rem; border-radius: 4px;
      font-size: 0.9rem; display: none; margin-bottom: 1rem;
    }
    .msg-ok  { background: #d4edda; color: #155724; display: block !important; }
    .msg-err { background: #f8d7da; color: #721c24; display: block !important; }

    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 640px) { .grid-2 { grid-template-columns: 1fr; } }
  </style>
</head>
<body>

<header>
  <span style="font-size:1.8rem">🏋️</span>
  <h1>Gimnasio Gran Fortaleza — Panel del Administrador</h1>
</header>

<main>

  <!-- Mensaje global de feedback -->
  <div id="mensaje"></div>

  <!-- Turnos disponibles -->
  <section>
    <h2>Turnos disponibles</h2>
    <table>
      <thead>
        <tr>
          <th>ID</th><th>Clase</th><th>Día</th><th>Hora</th><th>Capacidad</th><th>Estado</th>
        </tr>
      </thead>
      <tbody>
        <% turnos.forEach(turno => { %>
        <tr>
          <td><%= turno.id %></td>
          <td><%= turno.clase || '—' %></td>
          <td><%= turno.dia %></td>
          <td><%= turno.hora %></td>
          <td><%= turno.capacidad %></td>
          <td>
            <% if (turno.capacidad > 0) { %>
              <span class="badge badge-ok">Disponible</span>
            <% } else { %>
              <span class="badge badge-no">Lleno</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
        <% if (turnos.length === 0) { %>
          <tr><td colspan="6" style="text-align:center;color:#999">No hay turnos cargados</td></tr>
        <% } %>
      </tbody>
    </table>
  </section>

  <div class="grid-2">

    <!-- Formulario: Reservar -->
    <section>
      <h2>Nueva reserva</h2>
      <form id="formReservar">
        <div>
          <label for="nombreSocio">Nombre del socio</label>
          <input type="text" id="nombreSocio" placeholder="Ej: Juan Pérez" required />
        </div>
        <div>
          <label for="turnoId">Turno</label>
          <select id="turnoId" required>
            <option value="">— Seleccioná un turno —</option>
            <% turnos.forEach(turno => { %>
              <option value="<%= turno.id %>">
                <%= turno.dia %> <%= turno.hora %> (<%= turno.clase || 'Sin clase' %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div>
          <label for="fechaReserva">Fecha</label>
          <input type="date" id="fechaReserva" required />
        </div>
        <button type="submit" class="btn-primary">Confirmar reserva</button>
      </form>
    </section>

    <!-- Formulario: Cancelar -->
    <section>
      <h2>Cancelar reserva</h2>
      <form id="formCancelar">
        <div>
          <label for="reservaId">ID de la reserva</label>
          <input type="number" id="reservaId" placeholder="Ej: 5" required />
        </div>
        <div>
          <label for="socioId">ID del socio</label>
          <input type="number" id="socioId" placeholder="Ej: 3" required />
        </div>
        <button type="submit" class="btn-danger">Cancelar reserva</button>
      </form>
    </section>

  </div>

</main>

<script>
  function mostrarMensaje(texto, tipo) {
    const el = document.getElementById('mensaje');
    el.textContent = texto;
    el.className = tipo === 'ok' ? 'msg-ok' : 'msg-err';
    setTimeout(() => { el.className = ''; el.style.display = 'none'; }, 4000);
  }

  // Reservar
  document.getElementById('formReservar').addEventListener('submit', async (e) => {
    e.preventDefault();
    const nombre = document.getElementById('nombreSocio').value.trim();
    const turnoId = document.getElementById('turnoId').value;
    const fecha   = document.getElementById('fechaReserva').value;

    try {
      const res  = await fetch('/reservas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, turnoId, fecha })
      });
      const data = await res.json();
      if (data.ok) {
        mostrarMensaje('✅ Reserva confirmada correctamente', 'ok');
        e.target.reset();
      } else {
        mostrarMensaje('❌ ' + data.error, 'err');
      }
    } catch {
      mostrarMensaje('❌ Error de conexión con el servidor', 'err');
    }
  });

  // Cancelar
  document.getElementById('formCancelar').addEventListener('submit', async (e) => {
    e.preventDefault();
    const reservaId = document.getElementById('reservaId').value;
    const socioId   = document.getElementById('socioId').value;

    try {
      const res  = await fetch('/reservas/' + reservaId, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ socioId })
      });
      const data = await res.json();
      if (data.ok) {
        mostrarMensaje('✅ Reserva cancelada correctamente', 'ok');
        e.target.reset();
      } else {
        mostrarMensaje('❌ ' + data.error, 'err');
      }
    } catch {
      mostrarMensaje('❌ Error de conexión con el servidor', 'err');
    }
  });
</script>

</body>
</html>
